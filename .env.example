# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored, so your secrets stay on your machine.
# When deploying to Vercel, set these in Project Settings → Environment Variables.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Sheet lead capture — the Apps Script web app URL.
# Setup instructions: see scripts/google-sheet-webhook.gs
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# ── Optional: take the AI Visibility Audit off the Claude meter entirely. ──
# Each one is free-tier and optional; without them the audit falls back to
# Claude Haiku + Claude web search (a few cents per scan).

# Tavily web search, 1,000 free searches/month: https://app.tavily.com
# With this set, the audit's web searches cost nothing.
TAVILY_API_KEY=tvly-your-key-here

# Google AI Studio (Gemini flash free tier): https://aistudio.google.com/apikey
# With this set, the audit's scoring call costs nothing.
GEMINI_API_KEY=your-gemini-key-here
